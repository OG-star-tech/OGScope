# 仅用于已验证的 BCM2835 ISP；合并到板级配置后确认同一 ISP 实例的两个节点。
# Only for validated BCM2835 ISP systems; merge into board config and verify the paired nodes below.
OGSCOPE_CAMERA_TYPE=v4l2
OGSCOPE_CAMERA_V4L2_PROCESSING=auto
OGSCOPE_CAMERA_V4L2_ISP_INPUT_DEVICE=/dev/video13
OGSCOPE_CAMERA_V4L2_ISP_OUTPUT_DEVICE=/dev/video14
OGSCOPE_CAMERA_V4L2_ISP_TIMEOUT_SEC=2
OGSCOPE_CAMERA_WIDTH=1280
OGSCOPE_CAMERA_HEIGHT=720
OGSCOPE_CAMERA_FPS=8
OGSCOPE_CAMERA_SAMPLING_MODE=native
OGSCOPE_CAMERA_ROTATION=180
# 与色彩处理独立；星空几何验收前保留软件方向 / Independent of color processing; retain software orientation until sky acceptance.
OGSCOPE_CAMERA_HARDWARE_TRANSFORM=false
OGSCOPE_CAMERA_AUTO_EXPOSURE_MAX_US=3000000
OGSCOPE_CAMERA_WHITE_BALANCE_MODE=auto
OGSCOPE_CAMERA_NOISE_REDUCTION_MODE=off
OGSCOPE_CAMERA_V4L2_TEMPORAL_NR_ALPHA=1.0
OGSCOPE_SHARED_PREVIEW_FPS=8
OGSCOPE_PREVIEW_ENCODER=auto
OGSCOPE_PREVIEW_PIPELINE_ENABLED=true
