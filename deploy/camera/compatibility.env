# 默认兼容配置；与经过验证的板级 RAW/media/sensor 配置合并，不覆盖整个设备环境文件。
# Default compatibility profile; merge into verified board RAW/media/sensor settings, never replace the entire device env.
OGSCOPE_CAMERA_TYPE=v4l2
OGSCOPE_CAMERA_V4L2_PROCESSING=software
OGSCOPE_CAMERA_WIDTH=1280
OGSCOPE_CAMERA_HEIGHT=720
OGSCOPE_CAMERA_FPS=8
OGSCOPE_CAMERA_SAMPLING_MODE=native
OGSCOPE_CAMERA_ROTATION=180
# 硬件方向需通过独立的星空几何验收 / Hardware orientation requires separate sky-geometry acceptance.
OGSCOPE_CAMERA_HARDWARE_TRANSFORM=false
OGSCOPE_CAMERA_AUTO_EXPOSURE_MAX_US=3000000
OGSCOPE_CAMERA_WHITE_BALANCE_MODE=auto
OGSCOPE_CAMERA_NOISE_REDUCTION_MODE=off
OGSCOPE_CAMERA_V4L2_TEMPORAL_NR_ALPHA=1.0
OGSCOPE_SHARED_PREVIEW_FPS=8
OGSCOPE_PREVIEW_ENCODER=auto
OGSCOPE_PREVIEW_PIPELINE_ENABLED=false
