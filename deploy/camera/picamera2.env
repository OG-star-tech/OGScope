# 需要匹配的 Picamera2/libcamera 与产品 tuning；合并配置时保留安装路径和服务设置。
# Requires compatible Picamera2/libcamera and product tuning; preserve paths and service settings when merging.
OGSCOPE_CAMERA_TYPE=imx327_mipi
# V4L2 处理选项在此后端不生效 / V4L2 processing is inactive for this backend.
OGSCOPE_CAMERA_V4L2_PROCESSING=software
OGSCOPE_CAMERA_WIDTH=1280
OGSCOPE_CAMERA_HEIGHT=720
OGSCOPE_CAMERA_FPS=8
OGSCOPE_CAMERA_SAMPLING_MODE=native
OGSCOPE_CAMERA_ROTATION=180
OGSCOPE_CAMERA_HARDWARE_TRANSFORM=false
OGSCOPE_CAMERA_AUTO_EXPOSURE_MAX_US=3000000
OGSCOPE_CAMERA_WHITE_BALANCE_MODE=auto
OGSCOPE_CAMERA_NOISE_REDUCTION_MODE=fast
OGSCOPE_CAMERA_LORES_ENABLED=true
OGSCOPE_SHARED_PREVIEW_FPS=8
OGSCOPE_PREVIEW_ENCODER=auto
OGSCOPE_PREVIEW_PIPELINE_ENABLED=true
